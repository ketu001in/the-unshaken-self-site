# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.claude/

# raw brand source material — the assets the site actually uses are
# copied into public/brand/ and public/favicon*; these are reference
# files / superseded concept drafts, not site code
/TheUnshakenSelf_Production_Brand_Package/
/TheUnshakenSelf_Production_Brand_Package.zip
/TheUnshakenSelf_Logo_Pack/
/TheUnshakenSelf_Logo_Pack.zip
